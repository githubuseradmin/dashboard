# Copy this file to ".env" and adjust the values for your environment.
# python-dotenv loads it automatically when you run run.py / seed.py.

# Which config profile to use: development | production | testing
FLASK_ENV=development

# Secret key used to sign session cookies and CSRF tokens.
# Generate a strong value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Display name shown in the UI and used as the 2FA issuer.
APP_NAME=Dashboard

# --- Database ---------------------------------------------------------------
# SQLite (default): a file in the project directory.
DATABASE_URL=sqlite:///dashboard.db
#
# MySQL / MariaDB (requires PyMySQL -- see requirements.txt):
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/dashboard?charset=utf8mb4

# --- Security tuning --------------------------------------------------------
# Bcrypt work factor (cost). Higher = slower = more secure. 12 is a good default.
BCRYPT_ROUNDS=12

# Login rate limiting: lock an identifier after this many failed sign-ins
# within LOGIN_LOCKOUT_SECONDS, then reject further attempts until it clears.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Set to "true" only when serving over HTTPS so cookies are marked Secure.
SESSION_COOKIE_SECURE=false

# How long a session stays valid, in days.
SESSION_LIFETIME_DAYS=7

# --- Local dev server -------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# --- Seed account (optional overrides) --------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin12345!

# --- Telegram integration (optional) ----------------------------------------
# Leave TELEGRAM_BOT_TOKEN empty to disable all Telegram features.
# Create a bot with @BotFather to get the token and set its username below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Public HTTPS URL of the Mini App. With this app serving it, that is:
#   https://your-dashboard-domain/tg/app
# (Telegram requires HTTPS for Web Apps; a tunnel like Cloudflare works in dev.)
TELEGRAM_WEBAPP_URL=
# Seconds a sign-in approval / account-link stays valid.
LOGIN_REQUEST_TTL=300
TELEGRAM_LINK_TTL=600
